# ==============================================================================
# KLOZEVA PRODUCTION SAAS ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env.local` for local development. Never commit `.env` or secrets.
# ==============================================================================

# ---- 1. Application Environment Mode ----
# Options:
# - 'kiosk': In-store offline kiosk mode (ephemeral biometric RAM, zero cloud transmission)
# - 'staging': Pre-production validation with Supabase Auth, RLS, and test data
# - 'production': Multi-tenant commercial SaaS (MFA enforced, strict fail-closed auth)
# - 'development': Local development mode
VITE_APP_MODE=kiosk

# ---- 2. AI Model Execution Policy ----
# Options:
# - 'commercial': Strictly rejects non-commercial weights; uses MediaPipe baseline (Apache-2.0)
# - 'production': Enforces commercially cleared models; fails closed if unverified
# - 'research': Allows non-commercial evaluation models (e.g. SegFormer CelebAMask-HQ)
VITE_BEAUTY_MODEL_POLICY=commercial

# ---- 3. Backend Persistence Tier ----
# Options:
# - '' or 'localStorage': High-performance offline browser cache (Default for in-store kiosks)
# - 'supabase': Multi-tenant PostgreSQL with Row-Level Security and private storage
VITE_BEAUTY_BACKEND=localStorage

# ---- 4. Supabase Client Configuration (Public Variables) ----
# Required when VITE_BEAUTY_BACKEND=supabase or VITE_APP_MODE=production|staging
# These values are publicly exposed in the browser bundle; do NOT place private secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- 5. Server-Side Secrets (NEVER prefix with VITE_ and NEVER commit) ----
# These secrets must only be set in the Supabase Dashboard, Cloudflare Pages, or CI/CD secrets.
#
# Supabase Privileged Service-Role Key (Used strictly for server migrations and admin CLI)
# SUPABASE_SERVICE_ROLE_KEY=
#
# Google Gemini Multimodal Vision API Key (Configured strictly via: supabase secrets set GEMINI_API_KEY=...)
# GEMINI_API_KEY=
#
# Hugging Face Access Token (Used strictly for automated model synchronization in CI/CD)
# HUGGINGFACE_TOKEN=
