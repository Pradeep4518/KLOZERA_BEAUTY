# ---- Frontend (public by design) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Leave empty (default) and the app stores its data in the browser (localStorage), exactly like the original.
# Set to `supabase` to also persist the data in Supabase (apply migration 20260301000011 first) and run
# Gemini photo analysis through the `beauty-analyze` Edge Function.
VITE_BEAUTY_BACKEND=

# ---- Server secrets (never put API keys in frontend VITE_* variables) ----
# Set with: supabase secrets set GEMINI_API_KEY=...
# GEMINI_API_KEY=
